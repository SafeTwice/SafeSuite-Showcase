<?xml version="1.0" encoding="utf-8"?>
<StructuredDocument id="ce4d719f-5697-5ee3-8c90-c51d894f87c4" scheme-version="1">
  <Configuration>
    <ItemType id="bd7accc7-8d74-50ba-b9f2-548696e62844" name="Default">
      <AttributeDef id="ee0e0cc4-29b9-53a3-b18e-21651991c812" name="ID" type="PlainText">
