  <Item id="1e78f3b1-0ef4-5bcd-b52d-0aa5501e0dfe" type="Default">
    <Attribute name="ReqID">
      <Value>PTO-TSR-018</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Safety-related parameters (mode nominal speeds, ramp table, current windows) are stored twice with CRC-16 each; a mismatch or range violation at start-up inhibits engagement (parameterisation rules per Part 3, 7.8).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Type" value="0" />
    <Attribute name="AgPL" value="3" />
    <Attribute name="Allocation" value="0" />
    <Attribute name="Refines">
      <Value>PTO-FSR-003, -011</Value>
    </Attribute>
