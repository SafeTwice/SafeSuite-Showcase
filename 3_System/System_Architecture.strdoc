  <Item id="89c21e2b-92d4-597b-8817-d4d413afde70" type="Default">
    <Attribute name="ID">
      <Value>PTO-ARC-000</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+40%">System architecture — PTO-ECU 200</Text>
        </Paragraph>
        <Paragraph>E/E/PES architecture per ISO 25119-1 (3.12): allocation of the safety-related functions to ECUs, hardware and software, including communication. One ECU (PTO-ECU 200) implements both processing channels on separate microcontrollers.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Type" value="5" />
    <Attribute name="Status" value="3" />
  </Item>
  <Item id="79082fb8-847f-52db-80f2-4b664c64711a" type="Default">
    <Attribute name="ID">
      <Value>PTO-ARC-001</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">1. Architecture and category mapping</Text>
        </Paragraph>
        <Paragraph alignment="Center"><Image width="980.00" height="420.00"></Image></Paragraph>
        <Paragraph alignment="Center"><Text italic="true">Figure 1 — Category 3 designated architecture (25119-2 Annex A) mapped onto the PTO-ECU</Text></Paragraph>
        <Paragraph>Channel 1: cab-switch NO contact and seat switch conditioned into the main MCU (L1), driving the high-side smart switch O1. Channel 2: cab-switch NC contact and the PTO shaft-speed pickup into the monitor MCU (L2), driving the series low-side MOSFET O2. Both channels read the valve current (R5 shunt). Diverse MCUs (32-bit main, 16-bit monitor, different vendors) and diverse output technologies score the CCF diversity credit.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Type" value="1" />
    <Attribute name="Status" value="3" />
  </Item>
  <Item id="4afbcef1-2303-53e5-97f9-7c7cca818445" type="Default">
    <Attribute name="ID">
      <Value>PTO-ARC-002</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">2. Signal inventory</Text>
        </Paragraph>
        <Table><Column width="190.00"/><Column width="210.00"/><Column width="60.00"/><Column width="200.00"/><Row><Cell><Paragraph alignment="Center"><Text bold="true">Signal</Text></Paragraph></Cell><Cell><Paragraph alignment="Center"><Text bold="true">Source → sink</Text></Paragraph></Cell><Cell><Paragraph alignment="Center"><Text bold="true">Ch.</Text></Paragraph></Cell><Cell><Paragraph alignment="Center"><Text bold="true">Diagnostic</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>ENG_NO / ENG_NC</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>cab switch → L1 / L2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1+2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2-of-2 pattern, 50 ms skew (D-pattern)</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>SEAT_A / SEAT_B</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>seat switch → L1 / L2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1+2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>contact plausibility, 1 s debounce</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>FENDER_L / FENDER_R</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>fender buttons → L1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>stuck-at supervision on release</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>MODE_COD</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>selector → L1 (ADC)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>range + ratio cross-check (D2)</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>N_PTO</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>pickup → L2 (capture)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>gradient + ratio plausibility (D2)</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>N_ENG</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>J1939 EEC1 → L1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>timeout 100 ms, alive counter</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>VALVE_PWM</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>L1 → O1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>current window (D1), read-back</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>VALVE_EN</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>L2 → O2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>independent cut-off, read-back</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>I_VALVE</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>R5 shunt → L1 + L2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1+2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>window comparison both MCUs</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>P_CLUTCH</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>pressure switch → L2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>fill/empty plausibility vs command</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>SPI_XMON</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>L1 ↔ L2</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>—</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>Q&amp;A challenge, window watchdog (D4)</Text></Paragraph></Cell></Row></Table>
      </Value>
    </Attribute>
    <Attribute name="Type" value="1" />
    <Attribute name="Status" value="3" />
  </Item>
  <Item id="39e2858d-c98e-53ad-955b-4b072428a7a8" type="Default">
    <Attribute name="ID">
      <Value>PTO-ARC-003</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">3. Degraded modes</Text>
        </Paragraph>
        <Paragraph>DM-1 Single input-contact implausibility: engagement inhibited, running PTO keeps running until stop command (availability), warning on.</Paragraph>
        <Paragraph>DM-2 Speed-plausibility fault: controlled disengage ramp, warning (PTO-HZ-07 answer).</Paragraph>
        <Paragraph>DM-3 Cross-monitoring or watchdog fault: immediate safe state by the surviving channel, latched (PTO-FSR-004).</Paragraph>
        <Paragraph>DM-4 CAN loss: engagement inhibited; running PTO unaffected (engine speed only refines the ramp — internal N_PTO suffices for supervision).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Type" value="1" />
    <Attribute name="Status" value="3" />
  </Item>
</StructuredDocument>
