<StructuredDocument id="a8af177a-1731-5703-843b-fbd689e8c40c" scheme-version="1">
  <Configuration>
    <ItemType id="c729fb75-22aa-5dad-b0db-77cb5ce8bc3a" name="Default">
      <AttributeDef id="69c4f3cc-42c5-5b6b-a587-6f73396b6a22" name="ReqID" type="PlainText">
        <Datatype maxLen="16" />
      </AttributeDef>
      <AttributeDef id="9db4a967-e199-5976-af54-6a32617d98f7" name="Contents" type="RichText" />
      <AttributeDef id="63a22273-d7d5-53d3-aebf-623775e5c259" name="SRL" type="Selection" initial-value="2" multi="false">
        <Datatype>
          <Choice id="0" name="SRL B" />
          <Choice id="1" name="SRL 1" />
          <Choice id="2" name="SRL 2" />
          <Choice id="3" name="SRL 3" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="b8ebf9ed-790c-52fc-93e7-00709aba050e" name="Refines" type="PlainText">
        <Datatype maxLen="26" />
      </AttributeDef>
      <AttributeDef id="c63c5b03-25c9-553c-b108-3b62a3248563" name="Partition" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="Application (L1)" />
          <Choice id="1" name="Diagnostics (L1)" />
          <Choice id="2" name="Monitor (L2)" />
