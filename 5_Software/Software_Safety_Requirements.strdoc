          <Choice id="3" name="SRL 3" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="f1301cdf-b548-5c75-9d75-a15852822079" name="Refines" type="PlainText">
        <Datatype maxLen="26" />
      </AttributeDef>
      <AttributeDef id="9d4758ba-8fd3-50bd-9e18-1f11d8f732f2" name="Partition" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="Application (L1)" />
          <Choice id="1" name="Diagnostics (L1)" />
          <Choice id="2" name="Monitor (L2)" />
          <Choice id="3" name="Both MCUs" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="0c50332b-b85d-5318-ae93-d1f198dad586" name="Status" type="Selection" initial-value="4" multi="false">
        <Datatype>
          <Choice id="0" name="Open" />
          <Choice id="1" name="In review" />
