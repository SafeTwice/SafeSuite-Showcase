<?xml version="1.0" encoding="utf-8"?>
<StructuredDocument id="a8af177a-1731-5703-843b-fbd689e8c40c" scheme-version="1">
  <Configuration>
    <ItemType id="6562b54d-c078-5e54-951a-7bfcfac77a10" name="Default">
      <AttributeDef id="83b23a56-20cb-5cf3-836e-f4fe68eadc39" name="ReqID" type="PlainText">
        <Datatype maxLen="16" />
      </AttributeDef>
      <AttributeDef id="e67eb05f-f6c7-5f01-82c8-9c474cfed38a" name="Contents" type="RichText" />
      <AttributeDef id="029c6fda-4293-5803-8a40-a23446a8e0e8" name="SRL" type="Selection" initial-value="2" multi="false">
        <Datatype>
          <Choice id="0" name="SRL B" />
          <Choice id="1" name="SRL 1" />
