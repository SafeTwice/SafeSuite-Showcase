        </Datatype>
      </AttributeDef>
      <AttributeDef id="879f6e01-fa71-5bc3-89d6-176602ebe760" name="Status" type="Selection" initial-value="4" multi="false">
        <Datatype>
          <Choice id="0" name="Open" />
          <Choice id="1" name="In review" />
          <Choice id="2" name="Agreed" />
          <Choice id="3" name="Implemented" />
          <Choice id="4" name="Verified" />
        </Datatype>
      </AttributeDef>
    </ItemType>
    <TabularViewConfig name="Default" default="true">
      <Attribute name="ReqID" width="104.00" />
      <Attribute name="Contents" width="540.00" />
