nment="Left"><Text>H. Larsen</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-04</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>HW design + metrics</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>3/6</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>TSC</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>P. Ferraro</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-06</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>SW design (SRL 2)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>3/7</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>TSC</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>C. Moreau</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-06</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Safety analyses (FIT/FMEA/FTA)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2/7 + 3/6</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>BOM rev C</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>P. Ferraro</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-06</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Safety validation</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>4/6</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>V&amp;V plan</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>T. Kowal</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-07</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Assessment of functional safety</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>1/7</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>all above</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>G. Hoffmann</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-08</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Product release (functional safety)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>4/8</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>assessment</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>E. Vidal</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2026-08</Text></Paragraph></Cell></Row></Table>
