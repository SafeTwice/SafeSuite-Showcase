<?xml version="1.0" encoding="utf-8"?>
<StructuredDocument id="f9131c26-c3b5-5ece-aa82-344f8adcbb92" scheme-version="1">
  <Configuration>
    <ItemType id="0c0870ac-7c5d-5cff-8794-76e0353e421b" name="Default">
      <AttributeDef id="56ac9100-c3a7-5bf3-ac38-af0705ecad03" name="HazID" type="PlainText">
        <Datatype maxLen="14" />
      </AttributeDef>
      <AttributeDef id="0d4bdb9f-e85d-53d7-b1a4-47211f19da9d" name="Contents" type="RichText" />
      <AttributeDef id="bb08b29f-8f96-5c8d-b830-c65d9417a8ca" name="Severity" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="S0" />
          <Choice id="1" name="S1" />
          <Choice id="2" name="S2" />
          <Choice id="3" name="S3" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="cc0c2c8b-1030-5b74-8867-a4116a89bbdb" name="Exposure" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="E0" />
          <Choice id="1" name="E1" />
          <Choice id="2" name="E2" />
          <Choice id="3" name="E3" />
          <Choice id="4" name="E4" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="ec1edc42-e737-51ea-82af-62d48ea4a5bb" name="Controllability" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="C0" />
          <Choice id="1" name="C1" />
          <Choice id="2" name="C2" />
          <Choice id="3" name="C3" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="19d1a3b9-a3ab-59ad-83f4-c01df2d15bbf" name="AgPLr" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="QM" />
          <Choice id="1" name="AgPL a" />
          <Choice id="2" name="AgPL b" />
          <Choice id="3" name="AgPL c" />
          <Choice id="4" name="AgPL d" />
          <Choice id="5" name="AgPL e" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="9a734184-8245-5eaf-b3c7-651759738a4e" name="Safety goal" type="PlainText">
        <Datatype maxLen="14" />
      </AttributeDef>
      <AttributeDef id="96e5a883-a9c8-5c08-a83f-822b8fb53566" name="Safe state" type="Selection" initial-value="2" multi="false">
        <Datatype>
          <Choice id="0" name="Clutch open + PTO brake" />
          <Choice id="1" name="Warning + degraded" />
          <Choice id="2" name="None (QM)" />
        </Datatype>
      </AttributeDef>
      <AttributeDef id="0e706450-d97f-59f8-ba2b-3c409a645061" name="Rationale" type="RichText" />
    </ItemType>
    <TabularViewConfig name="Default" default="true">
      <Attribute name="HazID" width="96.00" />
      <Attribute name="Contents" width="470.00" />
      <Attribute name="Severity" width="80.00" />
      <Attribute name="Exposure" width="80.00" />
      <Attribute name="Controllability" width="108.00" />
      <Attribute name="AgPLr" width="84.00" />
      <Attribute name="Safety goal" width="104.00" />
    </TabularViewConfig>
  </Configuration>
  <Item id="407ee6fa-dc8a-5b18-b6f1-01a6fb68e180" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-000</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+40%">Hazard Analysis and Risk Assessment — Rear PTO</Text>
        </Paragraph>
        <Paragraph>HARA per ISO 25119-2:2018, Clause 6, for the faulted UoO (malfunctioning behaviour of the PTO control). Participants: E. Vidal (safety), H. Larsen (systems), C. Reid (field/operator view), P. Ferraro (hardware), G. Hoffmann (assessor, observer). Harm to persons only; property-only outcomes are recorded as QM.</Paragraph>
        <Paragraph>Method: system states and transitions per the state flowchart in the Technical Safety Concept; for every malfunction the relevant operating situations were rated. Where frequency and duration methods give different exposure classes, the higher class is used (6.3.5).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="0" />
    <Attribute name="Exposure" value="0" />
    <Attribute name="Controllability" value="0" />
    <Attribute name="AgPLr" value="0" />
    <Attribute name="Safety goal">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Safe state" value="2" />
    <Attribute name="Rationale" />
  </Item>
  <Item id="e5b391d1-6d7c-583c-909a-c93d4352a0ee" type="Default">
    <Attribute name="HazID">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">Risk graph</Text>
        </Paragraph>
        <Paragraph alignment="Center"><Image width="820.00" height="900.00"></Image></Paragraph>
        <Paragraph alignment="Center"><Text italic="true">Figure 1 — AgPLr determination (ISO 25119-2 Fig. 1); rated cells of this HARA are ringed</Text></Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="0" />
    <Attribute name="Exposure" value="0" />
    <Attribute name="Controllability" value="0" />
    <Attribute name="AgPLr" value="0" />
    <Attribute name="Safety goal">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Safe state" value="2" />
    <Attribute name="Rationale" />
  </Item>
  <Item id="f22cd714-04df-5d73-97c0-ffd54c3254ee" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-01</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Unintended PTO engagement while a person is at the implement or driveline (coupling the shaft, fitting the guard, adjusting the machine; engine running, PTO commanded OFF).</Paragraph>
        <Paragraph>Harm scenario: clothing or limb caught by the engaging shaft/implement intake — entanglement injuries.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="3" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="4" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-01</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S3: entanglement by a 540 rpm shaft is life-threatening, survival uncertain (accident statistics for PTO entanglement).</Paragraph>
        <Paragraph>E3: by the frequency method — a person is in the driveline zone with the engine running more than once per month on every livestock or mixed farm (coupling is part of nearly every implement use). Duration method would give E2; the higher class governs (6.3.5).</Paragraph>
        <Paragraph>C3: once engagement starts, a person in contact with the shaft cannot avoid harm.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="0b29ff6f-dd16-5e6a-b101-98a5d55a96ea" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-02</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Unintended engagement with a bystander next to a stationary implement (slurry pump, auger) — person feeding or clearing the machine while PTO is OFF.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="3" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-01</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>Same failure as PTO-HZ-01, different situation: bystander presence at a parked, powered machine is less frequent (E2: 0.1–1 % of operating time). Bounded by PTO-HZ-01; SG-01 carries the higher AgPLr d.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="12ec2703-da97-570f-b2f6-20ad114c8a9f" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-03</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>PTO fails to disengage on operator stop command. Typical scenario: baler pickup blocks, operator commands PTO OFF and dismounts to clear it while the shaft is in fact still driven.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="3" />
    <Attribute name="Controllability" value="2" />
    <Attribute name="AgPLr" value="3" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-02</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S3: intake/pickup entanglement.</Paragraph>
        <Paragraph>E3: intervening at the implement after a stop command is routine (blockages, wrapping, checking) — more than once per month.</Paragraph>
        <Paragraph>C2: mostly controllable — a still-turning shaft or implement is visible and audible before contact for &gt;90 % of persons (trained operators check); not C1 because noise/enclosure can mask it, not C3 because the cue exists.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="28c09e1f-e36f-58b5-a30b-35ba7cb36e2e" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-04</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>PTO does not shut off when the operator leaves the seat during mobile work (operator-presence function fails), operator walks to the still-driven implement.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="3" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-03</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S3 as above. E2: leaving the seat with the PTO running (outside the stationary-work exception) is occasional. C3: the operator believes the presence function has shut the PTO off — no cue prompts a check before contact.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="27283342-1009-5922-ba08-bb3f0bfe5ffc" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-05</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Automatic re-engagement at key-on / engine restart with the cab switch still latched from the previous session; person at the implement during the morning start.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="3" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-03</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>Restart with a latched switch is a classic PTO accident pattern. E2 by frequency (restarts with implement attached and person nearby: &gt;1/year, &lt;1/month for the hazardous combination). C3: no warning precedes the engagement.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="ca294265-87e4-5a2f-939c-faadf79de97e" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-06</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Fender jog latches ON or fails to stop on button release — the operator standing at the fender is within arm's reach of the turning shaft end.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="2" />
    <Attribute name="AgPLr" value="2" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-04</Value>
    </Attribute>
    <Attribute name="Safe state" value="0" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S3: shaft-end entanglement. E2: fender jog is used during coupling only. C2: the user's hand is on the button and the jog speed is limited to creep (≤ 20 rpm) — releasing/stepping back succeeds for &gt;90 %; not C1 because the person is inside the danger zone by definition.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="fca994ab-2006-5aab-b190-6fdec3def2e1" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-07</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Shaft overspeed: 1000-mode speed delivered while a 540-only implement is attached (wrong internal mode or wrong ratio supervision). Implement overspeed → break-up, ejected parts hitting a bystander.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="3" />
    <Attribute name="Exposure" value="1" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="2" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-05</Value>
    </Attribute>
    <Attribute name="Safe state" value="1" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S3 for a struck bystander (fragments). E1: requires simultaneous mode malfunction, 540-only implement, near-field bystander — rare (&lt;1/year). C3: no avoidance once break-up occurs. Driver in cab rated separately S2/E2/C3 → b; the governing class stays b.</Paragraph>
        <Paragraph>Safe state: warning + controlled disengage (degraded); an abrupt cut at full load is itself hazardous, see PTO-TSR-016.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="80e676f8-62da-5190-acb3-bc93ef93394b" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-08</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Engagement without torque ramp (full pressure step): driveline shock can shear shaft bolts / yoke, fragments near the hitch area.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="2" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="3" />
    <Attribute name="AgPLr" value="2" />
    <Attribute name="Safety goal">
      <Value>PTO-SG-05</Value>
    </Attribute>
    <Attribute name="Safe state" value="1" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>S2: fragment energies at engagement speed are lower than the break-up case (severe, survival probable). E2: engagement happens every use, but the harm needs a person beside the hitch at that moment. C3: no reaction possible.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="d926e525-0c36-5eae-aa8a-47553d0314f5" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-09</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>PTO state indication wrong (cluster lamp shows OFF while shaft is driven). Contributes to PTO-HZ-03-type scenarios; standalone harm requires additional failures.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="2" />
    <Attribute name="Exposure" value="1" />
    <Attribute name="Controllability" value="2" />
    <Attribute name="AgPLr" value="0" />
    <Attribute name="Safety goal">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Safe state" value="2" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>Indication is a supporting function: harm needs the primary channel to have failed as well. Rated standalone S2/E1/C2 → QM; developed under quality measures, no AgPL. It is nevertheless supervised (CAN alive counter) because of its contribution to controllability in PTO-HZ-03.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="21aa9abf-b710-5e8a-874e-5be8ad687582" type="Default">
    <Attribute name="HazID">
      <Value>PTO-HZ-10</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Unintended engagement during road transport with no implement attached (stub shaft turns under its guard).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="1" />
    <Attribute name="Exposure" value="2" />
    <Attribute name="Controllability" value="2" />
    <Attribute name="AgPLr" value="0" />
    <Attribute name="Safety goal">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Safe state" value="2" />
    <Attribute name="Rationale">
      <Value>
        <Paragraph>The guarded stub shaft without an implement exposes no person; residual risk limited to the missing-guard misuse case → S1. QM; the master guard requirement itself is mechanical (ISO 4254-1) and outside the UoO.</Paragraph>
      </Value>
    </Attribute>
  </Item>
  <Item id="2ed6927d-b9a1-5f2e-9d9a-23c1ef3fdcc7" type="Default">
    <Attribute name="HazID">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">Result</Text>
        </Paragraph>
        <Paragraph>Highest requirement: AgPL d (PTO-HZ-01). Safety goals PTO-SG-01 … PTO-SG-05 are derived in the Functional Safety Concept; every hazardous situation with AgPLr &gt; QM is covered by exactly one safety goal. This HARA is reworked on any change of the UoO scope (impact analysis per ISO 25119-4 Clause 11).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Severity" value="0" />
    <Attribute name="Exposure" value="0" />
    <Attribute name="Controllability" value="0" />
    <Attribute name="AgPLr" value="0" />
    <Attribute name="Safety goal">
      <Value>→ FSC</Value>
    </Attribute>
    <Attribute name="Safe state" value="2" />
    <Attribute name="Rationale" />
  </Item>
</StructuredDocument>
