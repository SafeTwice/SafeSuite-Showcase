<StructuredDocument id="9c8cc7e1-2d2a-59a7-b177-bc35ae2f4446" scheme-version="1">
  <Configuration>
    <ItemType id="d381fc83-9361-513c-b243-b6291ec1162c" name="Default">
      <AttributeDef id="4579d51f-b142-59cf-895d-457e3a0542f7" name="Section" type="PlainText">
