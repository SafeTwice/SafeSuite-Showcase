  <Item id="77b239c7-1126-4b51-b5ba-54a5bcf25a55" type="Default" level="3">
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="false" italic="false">Never approach the shaft before the </Text>
          <Text bold="false" italic="true">standstill lamp</Text>
          <Text bold="false" italic="false"> goes dark. Hazards catalogued in </Text>
          <Hyperlink href="safesuite://document/f9131c26-c3b5-5ece-aa82-344f8adcbb92">the HARA</Hyperlink>
          <Text bold="false" italic="false">.</Text>
        </Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Type" value="4" />
    <Attribute name="ReqID">
      <Value>MAN-1.1.1</Value>
