<?xml version="1.0" encoding="utf-8"?>
<StructuredDocument id="61d3f6e3-ec3d-5944-b0ed-57bf4c04db35" scheme-version="1">
  <Configuration>
    <ItemType id="fd6c084f-c2cf-50ec-a9d2-99c30be5afc1" name="Default">
      <AttributeDef id="590a285e-06e9-5ce7-9978-3a1b4f49567e" name="Section" type="PlainText">
        <Datatype maxLen="30" />
      </AttributeDef>
      <AttributeDef id="faf2fb58-a979-5cb7-9e8a-1437a4570a79" name="Contents" type="RichText" />
    </ItemType>
