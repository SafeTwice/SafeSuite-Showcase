<?xml version="1.0" encoding="utf-8"?>
<StructuredDocument id="1e83e0dc-be63-51bd-bbf1-4b8da502c31a" scheme-version="1">
  <Configuration>
    <ItemType id="4f3eb104-75b2-5ee1-b234-36e01b60553c" name="Default">
      <AttributeDef id="405d59d8-e9f3-5c90-9567-244e38b0dd6a" name="Metric" type="PlainText">
        <Datatype maxLen="30" />
      </AttributeDef>
      <AttributeDef id="025840ad-8006-5e7c-962a-9d325768993d" name="Contents" type="RichText" />
      <AttributeDef id="700d269c-029a-5faf-8779-65c2539d37b2" name="λd (FIT)" type="Real" initial-value="0">
      </AttributeDef>
      <AttributeDef id="9dce78bf-f41b-50d2-85f4-4c8c74d9c22c" name="λdd (FIT)" type="Real" initial-value="0">
      </AttributeDef>
      <AttributeDef id="f81b96ec-ce75-5284-ba3b-6886e452fce5" name="MTTFd (y)" type="Computed">
        <Datatype expr="1000000000 / ([λd (FIT)] * 8760)" />
      </AttributeDef>
      <AttributeDef id="acf9a7c7-338b-5a91-ab14-24076ff2f5d6" name="DCavg (%)" type="Computed">
        <Datatype expr="100 * [λdd (FIT)] / [λd (FIT)]" />
      </AttributeDef>
      <AttributeDef id="87216bc0-bc47-5675-9112-35757333ffb3" name="Target" type="Real" initial-value="0">
      </AttributeDef>
      <AttributeDef id="e5c49bba-5c2d-5cf8-9385-e4e992dd89e2" name="Margin" type="Computed">
        <Datatype expr="1000000000 / ([λd (FIT)] * 8760) - [Target]" />
      </AttributeDef>
      <AttributeDef id="b3e8f1bc-6ec8-5aeb-b7a3-ed96f80adb34" name="Verdict" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="—" />
          <Choice id="1" name="PASS" />
          <Choice id="2" name="FAIL" />
        </Datatype>
      </AttributeDef>
    </ItemType>
    <ItemType id="cd4407c3-4e62-5f79-9ec5-96981c881e9d" name="Derived">
      <AttributeDef id="661eb2cc-08e9-5aca-b2b0-5377a2ef4da9" name="Metric" type="PlainText">
        <Datatype maxLen="30" />
      </AttributeDef>
      <AttributeDef id="37aab5ce-347e-5b03-9f14-771aef674da0" name="Contents" type="RichText" />
      <AttributeDef id="07a61f3c-92e7-538a-900b-a327fa25b72e" name="λd (FIT)" type="Real" initial-value="0">
      </AttributeDef>
      <AttributeDef id="46658a1a-30e7-579a-ab12-99f69421984a" name="MTTFd (y)" type="Computed">
        <Datatype expr="1000000000 / ([λd (FIT)] * 8760)" />
      </AttributeDef>
      <AttributeDef id="7f68cae8-4e82-5ce2-889f-4c6fc44bc379" name="Target" type="Real" initial-value="0">
      </AttributeDef>
      <AttributeDef id="96917ebb-3a0c-59e8-a748-ee166dcbe0e5" name="Margin" type="Computed">
        <Datatype expr="1000000000 / ([λd (FIT)] * 8760) - [Target]" />
      </AttributeDef>
      <AttributeDef id="37daa137-b19c-5fd2-97a1-8807dad96b10" name="Verdict" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="—" />
          <Choice id="1" name="PASS" />
          <Choice id="2" name="FAIL" />
        </Datatype>
      </AttributeDef>
    </ItemType>
    <ItemType id="41cd42af-a72c-5e1b-81df-c30bd22e5c08" name="Heading">
      <AttributeDef id="58fa95d7-f8c9-5ad4-946f-1f75f188cb8f" name="Metric" type="PlainText">
        <Datatype maxLen="30" />
      </AttributeDef>
      <AttributeDef id="ff74b3fd-aafc-5187-b45e-8f9d405b634c" name="Contents" type="RichText" />
      <AttributeDef id="d04ff96c-5983-5f95-b8c0-419025509de6" name="Verdict" type="Selection" initial-value="0" multi="false">
        <Datatype>
          <Choice id="0" name="—" />
          <Choice id="1" name="PASS" />
          <Choice id="2" name="FAIL" />
        </Datatype>
      </AttributeDef>
    </ItemType>
    <TabularViewConfig name="Default" default="true">
      <Attribute name="Metric" width="170.00" />
      <Attribute name="Contents" width="430.00" />
      <Attribute name="λd (FIT)" width="84.00" />
      <Attribute name="λdd (FIT)" width="84.00" />
      <Attribute name="MTTFd (y)" width="88.00" />
      <Attribute name="DCavg (%)" width="88.00" />
      <Attribute name="Target" width="70.00" />
      <Attribute name="Margin" width="80.00" />
      <Attribute name="Verdict" width="80.00" />
    </TabularViewConfig>
  </Configuration>
  <Item id="43a28b6e-1727-5e6c-95f6-54c2ea79dd59" type="Heading">
    <Attribute name="Metric">
      <Value>—</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+40%">Reliability metrics — Category 3 verification</Text>
        </Paragraph>
        <Paragraph>Quantitative verification of the selected combination (25119-2, 7.3.5): MTTFd class per Table 4 (medium = 10–30 y per channel), DCavg per Table 5 (medium = 60–90 %), CCF per Annex D (≥ 65). Component failure rates come from the SafeFIT prediction (IEC/TR 62380, mission profile 'Agricultural tractor, cab ECU'); the dangerous fraction and diagnostic credit per failure mode come from the SafeFMEA (7_Analyses).</Paragraph>
        <Paragraph>The MTTFd, DCavg and margin columns of this table are live SafeSuite computed attributes — edit a λ value and the derived figures recompute (the norm's conversion 1 FIT = 1e-9/h, year = 8760 h).</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Verdict" value="0" />
  </Item>
  <Item id="b8844cc2-abfc-5b0d-84e9-a3291a076922" type="Default">
    <Attribute name="Metric">
      <Value>Channel 1 (L1 + O1 path)</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Main MCU, input conditioning ch1, high-side driver, shunt, supply share. λ values aggregated from the SafeFIT project over the FMEA dangerous modes.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="λd (FIT)" value="245.09" />
    <Attribute name="λdd (FIT)" value="179.41" />
    <Attribute name="MTTFd (y)" />
    <Attribute name="DCavg (%)" />
    <Attribute name="Target" value="10" />
    <Attribute name="Margin" />
    <Attribute name="Verdict" value="1" />
  </Item>
  <Item id="11279314-cf73-5bd3-b9a0-d0e2463acb3c" type="Default">
    <Attribute name="Metric">
      <Value>Channel 2 (L2 + O2 path)</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>Monitor MCU, NC-contact path, speed pickup conditioning, low-side MOSFET, watchdog.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="λd (FIT)" value="159.54" />
    <Attribute name="λdd (FIT)" value="120.39" />
    <Attribute name="MTTFd (y)" />
    <Attribute name="DCavg (%)" />
    <Attribute name="Target" value="10" />
    <Attribute name="Margin" />
    <Attribute name="Verdict" value="1" />
  </Item>
  <Item id="37a36c2f-1a3c-536c-9878-d9bfa37cea92" type="Derived">
    <Attribute name="Metric">
      <Value>Symmetric MTTFdC</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">Symmetrised two-channel MTTFd (Annex B.4)</Text>
        </Paragraph>
        <Paragraph>MTTFdC = (2/3) · harmonic combination of the channel values — computed by the analysis stage: 599.5 y (medium). Formula B.4 applied to the two channel MTTFd values above.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="λd (FIT)" value="190.43" />
    <Attribute name="MTTFd (y)" />
    <Attribute name="Target" value="10" />
    <Attribute name="Margin" />
    <Attribute name="Verdict" value="1" />
  </Item>
  <Item id="a10ce60d-36ed-512b-a005-0f5f82ec480b" type="Heading">
    <Attribute name="Metric">
      <Value>CCF score</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">CCF score (Annex D)</Text>
        </Paragraph>
        <Paragraph>Separation 15/15 (opposite connector rows, split harness), diversity 20/20 (diverse MCUs + output technologies), design/application 15/20 (overvoltage protection, proven components; over-actuation protection partial), FMEA-informed design 5/5, training 5/5, EMC tested 25/25, other environmental 0/10 (vibration retest pending, OB-3). Total 85 ≥ 65 → PASS.</Paragraph>
      </Value>
    </Attribute>
    <Attribute name="Verdict" value="1" />
  </Item>
  <Item id="d191f749-27f6-5a7e-97da-d47a1c1143e2" type="Heading">
    <Attribute name="Metric">
      <Value>FTA residuals</Value>
    </Attribute>
    <Attribute name="Contents">
      <Value>
        <Paragraph>
          <Text bold="true" font-size="+16%">FTA top-event residuals (mission 8760 h basis)</Text>
        </Paragraph>
        <Table><Column width="260.00"/><Column width="130.00"/><Column width="260.00"/><Row><Cell><Paragraph alignment="Center"><Text bold="true">Top event</Text></Paragraph></Cell><Cell><Paragraph alignment="Center"><Text bold="true">Residual</Text></Paragraph></Cell><Cell><Paragraph alignment="Center"><Text bold="true">Dominated by</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Unintended engagement (SG-01)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>2.9 FIT</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>CCF residual + undetected driver stage faults</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Fails to disengage (SG-02)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>11 FIT</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>valve spool jam (hydraulic context) + double stuck-on</Text></Paragraph></Cell></Row><Row><Cell><Paragraph alignment="Left"><Text>Restart without command (SG-03)</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>25.3 FIT</Text></Paragraph></Cell><Cell><Paragraph alignment="Left"><Text>latched-switch + interlock double faults</Text></Paragraph></Cell></Row></Table>
      </Value>
    </Attribute>
    <Attribute name="Verdict" value="1" />
  </Item>
</StructuredDocument>
